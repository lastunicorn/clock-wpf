<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea"
    xmlns:presentationConverters="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Converters">

    <presentationConverters:WorkContextStateToBrushConverter
        x:Key="WorkContextStateToBrushConverter1"
        ClosedBrush="Transparent"
        NewBrush="LimeGreen"
        UnmodifiedBrush="LimeGreen"
        ModifiedBrush="Orange"/>

    <presentationConverters:WorkContextStateToBrushConverter
        x:Key="WorkContextStateToBrushConverter2"
        ClosedBrush="Gray"
        NewBrush="LimeGreen"
        UnmodifiedBrush="LimeGreen"
        ModifiedBrush="Orange"/>

    <Style TargetType="{x:Type shapes:TemplateStatusHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shapes:TemplateStatusHeader}">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">

                        <Ellipse
                            x:Name="StatusEllipse"
                            Width="{TemplateBinding FontSize}"
                            Height="{TemplateBinding FontSize}"
                            Fill="{TemplateBinding Status, Converter={StaticResource WorkContextStateToBrushConverter1}}"
                            Stroke="{TemplateBinding Status, Converter={StaticResource WorkContextStateToBrushConverter2}}"
                            StrokeThickness="2"
                            VerticalAlignment="Center"
                            Margin="0 0 8 0"/>

                        <TextBlock
                            x:Name="TemplateNameTextBlock"
                            Text="{TemplateBinding TemplateName}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            VerticalAlignment="Center"/>

                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
