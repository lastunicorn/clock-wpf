<UserControl
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea.AvailableShapesControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea"
    
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance shapes:AvailableShapesViewModel}">

	<ListBox
        ItemsSource="{Binding Shapes, Mode=OneWay}"
        SelectedItem="{Binding SelectedShape}"
        DisplayMemberPath="">

		<ListBox.ItemTemplate>
			<DataTemplate>
				<Border Padding="0 1">
					<StackPanel>

						<TextBlock
                            Text="{Binding Name, Mode=OneWay}"
                            FontWeight="DemiBold"/>

						<TextBlock
                            Text="{Binding Type, Mode=OneWay}"
                            FontSize="11"
                            Foreground="Gray"
                            Margin="10 0 0 0"/>

					</StackPanel>
				</Border>
			</DataTemplate>
		</ListBox.ItemTemplate>

	</ListBox>

</UserControl>
