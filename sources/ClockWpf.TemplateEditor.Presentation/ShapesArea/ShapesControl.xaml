<UserControl
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea.ShapesControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea"
    xmlns:presentationConverters="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Converters"
    
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance shapes:ShapesViewModel}">

	<Grid
		Grid.Column="2">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<shapes:TemplateStatusHeader
			Grid.Row="0"
			TemplateName="{Binding TemplateName}"
			Status="{Binding WorkContextState}"
			FontSize="15"
			FontWeight="Bold"
			Margin="0 8 0 0"/>

		<StackPanel
			Grid.Row="1"
			Orientation="Horizontal"
			FlowDirection="RightToLeft"
			Margin="0 4 0 0">

			<Button
				Content="Reset"
				Padding="10 0"
				Command="{Binding ResetTemplateCommand}"/>

		</StackPanel>

		<TabControl
			Grid.Row="2"
			Margin="0 8 0 0"
			BorderThickness="0">

			<TabItem
				Header="In Use"
				IsSelected="True">

				<shapes:InUseShapesControl
					DataContext="{Binding InUseShapesViewModel}"/>

			</TabItem>

			<TabItem Header="Available">

				<shapes:AvailableShapesControl
					DataContext="{Binding AvailableShapesViewModel}"/>

			</TabItem>

		</TabControl>

	</Grid>

</UserControl>
