<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<GeometryGroup
		x:Key="InfoIconGeometry"
		FillRule="EvenOdd">

		<EllipseGeometry
			Center="50,50" 
			RadiusX="47" 
			RadiusY="47"/>

		<!--<EllipseGeometry 
			Center="50,50"
			RadiusX="37"
			RadiusY="37"/>-->

		<EllipseGeometry 
			Center="50,26" 
			RadiusX="6"
			RadiusY="6"/>

		<RectangleGeometry Rect="44,40,12,38"/>

	</GeometryGroup>

	<GeometryGroup 
		x:Key="WarningIconGeometry"
		FillRule="EvenOdd">
		
		<PathGeometry Figures="M 50,3 L 97,84 L 3,84 Z"/>
		<!--<PathGeometry Figures="M 50,23 L 79,73 L 21,73 Z"/>-->
		<RectangleGeometry Rect="46,32,8,27"/>
		
		<EllipseGeometry 
			Center="50,66"
			RadiusX="5"
			RadiusY="5"/>
		
	</GeometryGroup>

	<GeometryGroup 
		x:Key="ErrorIconGeometry" 
		FillRule="EvenOdd">
		
		<EllipseGeometry
			Center="50,50"
			RadiusX="48"
			RadiusY="48"/>
		
		<CombinedGeometry GeometryCombineMode="Union">
			
			<CombinedGeometry.Geometry1>
				<PathGeometry Figures="M 20,30 L 30,20 L 80,70 L 70,80 Z"/>
			</CombinedGeometry.Geometry1>
			
			<CombinedGeometry.Geometry2>
				<PathGeometry Figures="M 70,20 L 80,30 L 30,80 L 20,70 Z"/>
			</CombinedGeometry.Geometry2>
			
		</CombinedGeometry>
		
	</GeometryGroup>

</ResourceDictionary>