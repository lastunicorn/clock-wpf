<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.CustomControls">

	<Style TargetType="{x:Type customControls:NoteBox}">
		<Setter Property="Foreground" Value="#0D47A1"/>
		<Setter Property="Background" Value="#E3F2FD"/>
		<Setter Property="BorderBrush" Value="#64B5F6"/>
		<Setter Property="BorderThickness" Value="1"/>

		<Setter Property="ContentTemplateSelector">
			<Setter.Value>
				<customControls:NoteBoxContentTemplateSelector>
					<customControls:NoteBoxContentTemplateSelector.TextTemplate>
						<DataTemplate>
							<TextBlock
								TextWrapping="Wrap"
								TextAlignment="Justify"
								Text="{Binding}"/>
						</DataTemplate>
					</customControls:NoteBoxContentTemplateSelector.TextTemplate>
				</customControls:NoteBoxContentTemplateSelector>
			</Setter.Value>
		</Setter>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type customControls:NoteBox}">

					<ControlTemplate.Resources>
						<ResourceDictionary Source="/DustInTheWind.ClockWpf.TemplateEditor.Presentation;component/CustomControls/IconStyles.xaml"/>
					</ControlTemplate.Resources>

					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="3"
						Padding="8 6">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Path
								x:Name="Icon"
								Grid.Column="0"
								Width="16"
								Height="16"
								Margin="0 0 8 0"
								VerticalAlignment="Top"
								Stretch="Uniform"
								Fill="{TemplateBinding Foreground}"
								Data="{StaticResource InfoIconGeometry}"/>

							<ContentPresenter Grid.Column="1"/>

						</Grid>

					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="NoteType" Value="Warning">
							<Setter TargetName="Icon" Property="Data" Value="{StaticResource WarningIconGeometry}"/>
						</Trigger>

						<Trigger Property="NoteType" Value="Error">
							<Setter TargetName="Icon" Property="Data" Value="{StaticResource ErrorIconGeometry}"/>
						</Trigger>

					</ControlTemplate.Triggers>

				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<Style.Triggers>

			<Trigger Property="NoteType" Value="Warning">
				<Setter Property="Foreground" Value="#5D4037"/>
				<Setter Property="Background" Value="#FFF8E1"/>
				<Setter Property="BorderBrush" Value="#FFD54F"/>
			</Trigger>

			<Trigger Property="NoteType" Value="Error">
				<Setter Property="Foreground" Value="#B71C1C"/>
				<Setter Property="Background" Value="#FFEBEE"/>
				<Setter Property="BorderBrush" Value="#EF9A9A"/>
			</Trigger>

		</Style.Triggers>
	</Style>

</ResourceDictionary>
