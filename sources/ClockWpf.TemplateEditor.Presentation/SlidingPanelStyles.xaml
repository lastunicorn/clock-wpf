<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation">

    <Style TargetType="{x:Type local:SlidingPanel}">
        <Setter Property="HorizontalAlignment" Value="Right"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SlidingPanel}">

                    <Border
                        x:Name="PART_Border"
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Visibility="Collapsed">

                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                ShadowDepth="3"
                                Opacity="0.3"/>
                        </Border.Effect>

                        <ContentPresenter/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>