<UserControl
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.TemplatesArea.TemplatesControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:templates="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.TemplatesArea"
    xmlns:behaviors="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Behaviors"
    xmlns:converters="clr-namespace:DustInTheWind.ClockWpf.Converters;assembly=DustInTheWind.ClockWpf"
    xmlns:presentationConverters="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Converters"
    xmlns:local="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea"

    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance templates:TemplatesViewModel}">

    <UserControl.Resources>
        <presentationConverters:WorkContextStateToBrushConverter
            x:Key="WorkContextStateToBrushConverter1"
            ClosedBrush="Transparent"
            OpenedBrush="LimeGreen"
            ModifiedBrush="Orange"/>

		<presentationConverters:WorkContextStateToBrushConverter
            x:Key="WorkContextStateToBrushConverter2"
            ClosedBrush="Gray"
            OpenedBrush="LimeGreen"
            ModifiedBrush="Orange"/>
	</UserControl.Resources>

    <Grid
        Grid.Column="2">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="0 10 0 0">

            <StackPanel
                DockPanel.Dock="Top"
				Orientation="Horizontal"
				FlowDirection="RightToLeft">

                <Button
                    Content="Load"
                    Padding="10 0"
                    IsEnabled="False" />

                <Button
                    Content="Export"
                    Padding="10 0"
                    Margin="5 0 0 0"
                    Command="{Binding SaveTemplateCommand}" />

                <Button
                    Content="Reset"
                    Padding="10 0"
                    Margin="5 0 0 0"
                    Command="{Binding ResetTemplateCommand}" />

			</StackPanel>

			<ListBox
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate}"
				Margin="0 8 0 0"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled">

				<ListBox.ItemTemplate>
					<DataTemplate DataType="templates:TemplateDescriptor">
						<Border Padding="0 1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<Ellipse
									Grid.Column="0"
									Grid.Row="0"
									Width="10"
									Height="10"
									Fill="{Binding WorkContextState, Converter={StaticResource WorkContextStateToBrushConverter1}}"
									Stroke="{Binding WorkContextState, Converter={StaticResource WorkContextStateToBrushConverter2}}"
									StrokeThickness="2"
									VerticalAlignment="Center"
									Margin="0 0 5 0"/>

								<TextBlock
									Grid.Column="1"
									Grid.Row="0"
									Text="{Binding Name, Mode=OneWay}"
									FontWeight="DemiBold"/>

								<TextBlock
									Grid.Column="1"
									Grid.Row="1"
									Text="{Binding Description, Mode=OneWay}"
									FontSize="11"
									Foreground="Gray"
									Margin="10 0 0 0"
									TextWrapping="Wrap"/>

							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
				
			</ListBox>

		</DockPanel>

    </Grid>

</UserControl>
