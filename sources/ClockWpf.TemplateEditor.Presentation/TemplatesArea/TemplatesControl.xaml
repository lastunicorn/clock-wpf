<UserControl
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.TemplatesArea.TemplatesControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:templates="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.TemplatesArea"
    xmlns:behaviors="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Behaviors"
    xmlns:converters="clr-namespace:DustInTheWind.ClockWpf.Converters;assembly=DustInTheWind.ClockWpf"
    xmlns:local="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.ShapesArea"

    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance templates:TemplatesViewModel}">

    <Grid
        Grid.Column="2">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="0 10 0 0">

            <StackPanel
                DockPanel.Dock="Top"
				Orientation="Horizontal"
				FlowDirection="RightToLeft">

                <Button
                    Content="Load"
                    Padding="10 0"
                    IsEnabled="False" />

                <Button
                    Content="Export"
                    Padding="10 0"
                    Margin="5 0 0 0"
                    Command="{Binding SaveTemplateCommand}" />

                <Button
                    Content="Reset"
                    Padding="10 0"
                    Margin="5 0 0 0"
                    Command="{Binding ResetTemplateCommand}" />

			</StackPanel>

			<ListBox
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate}"
				Margin="0 8 0 0">

				<ListBox.ItemTemplate>
					<DataTemplate DataType="templates:TemplateDescriptor">
						<Border Padding="0 1">
							<StackPanel>

								<TextBlock
                                    Text="{Binding Name, Mode=OneWay}"
                                    FontWeight="DemiBold"/>

								<TextBlock
                                    Text="{Binding Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Margin="10 0 0 0"/>

							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
				
			</ListBox>

		</DockPanel>

    </Grid>

</UserControl>
