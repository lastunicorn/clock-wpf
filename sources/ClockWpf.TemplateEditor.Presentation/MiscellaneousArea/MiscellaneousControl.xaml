<UserControl 
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.MiscellaneousArea.MiscellaneousControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:miscellaneous="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.MiscellaneousArea"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.Shapes;assembly=DustInTheWind.ClockWpf"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:converters="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.Converters"
    
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance miscellaneous:MiscellaneousViewModel}">
    
    <UserControl.Resources>
		<converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0 10 0 0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock 
            Grid.Row="0" 
            Grid.Column="0"
            Text="Clock Direction:"
            VerticalAlignment="Top"
            Margin="5"
            FontWeight="DemiBold"/>
        
        <StackPanel 
            Grid.Row="0" 
            Grid.Column="1"
            Orientation="Vertical"
            Margin="5">
            
            <RadioButton 
                Content="Clockwise"
                IsChecked="{Binding ClockDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shapes:RotationDirection.Clockwise}}"
                Margin="0 0 0 10"
                VerticalAlignment="Center"/>
            
            <RadioButton 
                Content="Counterclockwise"
                IsChecked="{Binding ClockDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shapes:RotationDirection.Counterclockwise}}"
                VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
    
</UserControl>
