<UserControl
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.Presentation.MovementsArea.MovementsControl"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	xmlns:movements="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.MovementsArea"
	xmlns:customControls="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Presentation.CustomControls"
    
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance movements:MovementsViewModel}">

	<Grid
		Grid.Column="2">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="300"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*" MinHeight="0"/>
		</Grid.RowDefinitions>

		<customControls:NoteBox
			Grid.Row="0"
			Margin="0 10 0 0"
			NoteType="Info"
			Content="The movement selected here is not part of the clock template. It will not be saved with the template."/>

		<!--<customControls:NoteBox
			Grid.Row="0"
			Margin="0 10 0 0">

			<TextBlock
				Text="The movement selected here is not part of the clock template. It will not be saved with the template."
				TextWrapping="Wrap"/>
		</customControls:NoteBox>-->

		<Button
			Grid.Row="1"
            HorizontalAlignment="Right"
            Content="Reset"
            Padding="10 0"
            Margin="0 10 0 0"
            Command="{Binding ResetMovementCommand}" />

		<ListBox
			Grid.Row="2"
			ItemsSource="{Binding MovementDescriptors}"
			SelectedItem="{Binding SelectedMovementDescriptor}"
			HorizontalContentAlignment="Stretch"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			Margin="0 8 0 0">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Padding="0 1">
						<StackPanel>

							<TextBlock
                                Text="{Binding Name, Mode=OneWay}"
                                FontWeight="DemiBold"/>

							<TextBlock
                                Text="{Binding Description, Mode=OneWay}"
                                FontSize="11"
                                Foreground="Gray"
                                Margin="10 0 0 0"
								TextWrapping="Wrap"/>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

		<GridSplitter
			Grid.Row="3"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Height="10">

			<GridSplitter.Template>
				<ControlTemplate TargetType="{x:Type GridSplitter}">
					<Grid Background="Transparent">

						<Ellipse
							Width="55"
							Height="2"
							Fill="Gray"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />

					</Grid>
				</ControlTemplate>
			</GridSplitter.Template>

		</GridSplitter>

		<xctk:PropertyGrid
			Grid.Row="4"
            SelectedObject="{Binding SelectedMovement, Mode=OneWay}"
            ShowSortOptions="True"
            ShowSearchBox="True"
            ShowSummary="True"
            ShowAdvancedOptions="True"
            BorderThickness="0"
            Margin="0 8 0 0"/>
	</Grid>

</UserControl>
