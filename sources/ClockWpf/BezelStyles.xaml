<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DustInTheWind.ClockWpf"
    xmlns:converters="clr-namespace:DustInTheWind.ClockWpf.Converters">

    <converters:NegateConverter x:Key="NegateConverter"/>
    <converters:MultiplyConverter x:Key="MultiplyConverter"/>

    <Style TargetType="{x:Type local:Bezel}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Bezel}">

                    <Viewbox>
                        <Canvas
                            Width="100"
                            Height="100"
                            Background="{TemplateBinding Background}">
                            
                            <ContentPresenter
                                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockRadius, Converter={StaticResource MultiplyConverter}, ConverterParameter=2}"
                                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockRadius, Converter={StaticResource MultiplyConverter}, ConverterParameter=2}"
                                Canvas.Left="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockLocation.X}"
                                Canvas.Top="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockLocation.Y}"
                                RenderTransformOrigin="0.5,0.5">
                                
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform 
                                        X="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockRadius, Converter={StaticResource NegateConverter}}"
                                        Y="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ClockRadius, Converter={StaticResource NegateConverter}}"/>
                                </ContentPresenter.RenderTransform>
                                
                            </ContentPresenter>
                        </Canvas>
                    </Viewbox>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>