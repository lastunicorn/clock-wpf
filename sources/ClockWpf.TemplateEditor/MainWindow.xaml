<Window
    x:Class="DustInTheWind.ClockWpf.TemplateEditor.MainWindow"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:clockWpf="clr-namespace:DustInTheWind.ClockWpf;assembly=DustInTheWind.ClockWpf"
    xmlns:shapes="clr-namespace:DustInTheWind.ClockWpf.Shapes;assembly=DustInTheWind.ClockWpf"
    xmlns:performance="clr-namespace:DustInTheWind.ClockWpf.Performance;assembly=DustInTheWind.ClockWpf"
    xmlns:local="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor"
    xmlns:templates="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Templates"
    xmlns:movements="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Movements"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    
    mc:Ignorable="d"
    Title="Template Editor"
    Height="768"
    Width="1280"
    ResizeMode="CanResizeWithGrip"
    d:DataContext="{d:DesignInstance local:MainViewModel}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Margin="20"
            MouseWheel="AnalogClock_MouseWheel"
            MouseLeftButtonDown="ClockContainer_MouseLeftButtonDown"
            MouseLeftButtonUp="ClockContainer_MouseLeftButtonUp"
            MouseMove="ClockContainer_MouseMove"
            Background="Transparent"
            Cursor="Hand">

            <clockWpf:AnalogClock
                x:Name="analogClock1"
                ClockTemplate="{Binding ClockTemplate}"
                Movement="{Binding Movement}"
                PerformanceMeter="{Binding PerformanceMeter, Mode=OneWay}"
                RotationDirection="{Binding ClockDirection}">

                <clockWpf:AnalogClock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                        <TranslateTransform X="{Binding TranslateX}" Y="{Binding TranslateY}"/>
                    </TransformGroup>
                </clockWpf:AnalogClock.RenderTransform>

            </clockWpf:AnalogClock>

            <performance:PerformaceView
                DataContext="{Binding PerformanceMeter, Mode=OneWay}"/>

            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10 2"
                Click="ResetClockView_Click"
                Cursor="Arrow"
                ToolTip="Reset zoom and position">
                
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock
                        Text="⟲"
                        FontSize="16"
                        Margin="0 0 4 0"
                        VerticalAlignment="Center"/>
                    
                    <TextBlock
                        Text="Reset View"
                        VerticalAlignment="Center"/>
                    
                </StackPanel>
                
            </Button>

        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#f0f0f0" />

        <TabControl
            Grid.Column="2"
            BorderThickness="0"
            Margin="10">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                
                                <Grid Name="Panel">
                                    <ContentPresenter
                                        x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="12 4"/>
                                </Grid>
                                
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Panel" Property="Background" Value="LightGray" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                                
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Templates">
                <templates:TemplatesControl DataContext="{Binding TemplatesViewModel}"/>
            </TabItem>

            <TabItem Header="Movement">
                <movements:MovementsControl DataContext="{Binding MovementsViewModel}"/>
            </TabItem>

        </TabControl>

    </Grid>

</Window>
