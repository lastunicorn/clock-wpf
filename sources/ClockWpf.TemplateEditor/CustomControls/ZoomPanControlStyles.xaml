<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.CustomControls"
    xmlns:behaviors="clr-namespace:DustInTheWind.ClockWpf.TemplateEditor.Behaviors">

    <Style TargetType="{x:Type customControls:ZoomPanControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type customControls:ZoomPanControl}">

                    <Grid
                        Background="{TemplateBinding Background}"
                        Cursor="Hand"
                        behaviors:ZoomPanBehavior.IsEnabled="True"
                        behaviors:ZoomPanBehavior.Target="{Binding ElementName=PART_Content}"
                        ClipToBounds="True">

                        <ContentPresenter
                            x:Name="PART_Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="10 2"
                            Command="{TemplateBinding ResetViewCommand}"
                            CommandParameter="{Binding ElementName=PART_Content}"
                            Cursor="Arrow"
                            ToolTip="Reset zoom and position">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="⟲"
                                    FontSize="16"
                                    Margin="0 0 4 0"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Reset View"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>